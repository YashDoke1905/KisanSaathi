# ==============================================================================
# KisanSaathi Environment Variables
# ==============================================================================

# Application Metadata (Easy to rename anytime)
NEXT_PUBLIC_APP_NAME="KisanSaathi"
NEXT_PUBLIC_APP_VERSION="1.0.0"

# Local SQLite Database (Default, zero setup required)
DATABASE_URL="file:./dev.db"

# Production Supabase PostgreSQL (Uncomment and set for cloud production deployment)
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Authentication & Session Security (Change to a 32+ char random string in production)
JWT_SECRET="kisansaathi-super-secret-jwt-key-2026-secure-session"

# SMS OTP Provider Settings
# When OTP_DEV_MODE is "true", OTP codes are printed in server terminal & returned in debug response.
# In production, set OTP_DEV_MODE="false" and configure SMS_PROVIDER_API_KEY.
OTP_DEV_MODE="true"
SMS_PROVIDER_API_KEY=""

# Pluggable Agricultural API Keys (Optional - seed fallback works seamlessly if empty)
AGMARKNET_API_KEY=""
GEMINI_API_KEY=""
SARVAM_API_KEY=""
